# Copy this file to .env (or .env.local) and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

# ── Database (MongoDB via Prisma) — required ────────────────────────────────
# A MongoDB Atlas (or self-hosted) connection string. Prisma's schema.prisma
# is configured with provider = "mongodb", so this MUST be a mongodb:// or
# mongodb+srv:// URL, not a Postgres/MySQL one.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Used only by scripts/restore-drill-mongodb.ps1. It must point to a disposable
# database whose name clearly contains restore, drill, staging, or test.
RESTORE_TEST_DATABASE_URL=

# ── NextAuth (authentication) — required ────────────────────────────────────
# Random secret used to sign session/JWT tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The canonical URL of your deployment. Optional in local dev (NextAuth infers
# it), but set it explicitly in production so callback URLs resolve correctly.
NEXTAUTH_URL=http://localhost:3000
# Canonical public origin used for Stripe Checkout and Connect return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Separate HMAC secret for privacy-preserving rate-limit and IP audit hashes.
# Generate with: openssl rand -base64 32
RATE_LIMIT_SECRET=

# Disabled by default. Only enable temporarily for trusted API compatibility.
ENABLE_LEGACY_API_AUTH=false

# ── Mobile API sessions (server only) ────────────────────────────────────────
# These values are reserved for /api/mobile/v1. They are intentionally
# independent from NEXTAUTH_SECRET, RATE_LIMIT_SECRET, and CRON_SECRET.
# Use the canonical HTTPS API origin as the issuer outside local development.
MOBILE_TOKEN_ISSUER=http://localhost:3000
MOBILE_TOKEN_AUDIENCE=redrive-mobile-api
MOBILE_ACCESS_TOKEN_KEY_ID=development-1
# Store a PKCS#8 private key and a JSON key-id-to-public-key map in the secret
# manager. Keep a previous public key in the map while its tokens may be valid.
MOBILE_ACCESS_TOKEN_PRIVATE_KEY=
MOBILE_ACCESS_TOKEN_PUBLIC_KEYS=
# Generate an independent random value with at least 32 bytes of entropy.
MOBILE_REFRESH_TOKEN_PEPPER=
# Local/test-only escape hatch for displaying verification or OTP codes when
# SMTP is unavailable. This is ignored in production even if set to true.
MOBILE_ALLOW_AUTH_PREVIEWS=false

# Optional server-side token for authenticated Expo push delivery. This is not
# an EXPO_PUBLIC_ value and must never be bundled into the native application.
EXPO_ACCESS_TOKEN=

# Production mobile HTTPS association. Obtain these identifiers from the
# organization-owned Apple Developer and Google Play/EAS signing accounts.
MOBILE_APPLE_TEAM_ID=
MOBILE_IOS_BUNDLE_ID=au.com.redrive.app
MOBILE_ANDROID_PACKAGE=au.com.redrive.app
# Comma-separate fingerprints during signing-key rotation.
MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=

# Comma-separated emails allowed to access /admin after normal password sign-in.
# Keep this server-only and use accounts that already exist in Redrive.
ADMIN_EMAILS=admin@example.com

# Google OAuth client, used for "Sign in with Google". Create one at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, Web app,
# authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email verification (free SMTP, e.g. Gmail app password) ────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false.
# Use a Google app password for SMTP_PASS, not your normal account password.
# In local development only, the verification code is returned in the UI when
# these values are blank. Production requires SMTP configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Redrive <your-email@gmail.com>"
# Public-facing contacts shown in legal and support information pages.
PRIVACY_CONTACT_EMAIL=privacy@redrive.com.au
SUPPORT_CONTACT_EMAIL=support@redrive.com.au

# ── Google Maps / Places — required for the listing map & address search ───
# Enable "Maps JavaScript API" and "Places API" on the same Google Cloud
# project/key. This key IS exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: only needed if you've created a custom Map ID / styled map in
# Google Cloud Console for the listing map component.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server-side key used for Places autocomplete (kept off the client).
GOOGLE_PLACES_API_KEY=

# Server-only key for Google Cloud Vision document OCR. Enable the Cloud Vision
# API and restrict this key to that API. Licence images are sent to this service
# only when the authenticated user starts the licence check from Profile.
GOOGLE_CLOUD_VISION_API_KEY=

# Encrypts recoverable licence and card numbers at the application layer.
# Generate exactly 32 random bytes encoded as base64, for example:
#   openssl rand -base64 32
LICENSE_DATA_ENCRYPTION_KEY=
# Separate random secret used to create non-reversible duplicate-check HMACs.
LICENSE_DATA_HMAC_KEY=

# ── Cloudinary — required for image upload ──────────────────────────────────
# From your Cloudinary dashboard (cloudinary.com/console).
# Uploads are signed by app/api/upload/route.ts; no unsigned upload preset is
# needed. The cloud name identifies the Cloudinary product environment.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only — used by app/api/upload/route.ts. Never prefix these with
# NEXT_PUBLIC_, that would bundle the secret into client-side JS.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cron (scheduled notifications) — required in production ────────────────
# Random secret, e.g. `openssl rand -base64 32`. Also add the same value to
# the "CRON_SECRET" env var in your Vercel project settings — Vercel Cron
# then sends it automatically as `Authorization: Bearer <value>` when it
# calls /api/cron/notifications on the schedule in vercel.json.
CRON_SECRET=

# ── Admin API monitoring — optional low-load sampling controls ─────────────
# Production defaults are 25% of successful requests and 50% of handled 4xx
# responses. All 5xx responses are always recorded. Use 1 for full sampling.
API_MONITOR_SUCCESS_SAMPLE_RATE=0.25
API_MONITOR_CLIENT_ERROR_SAMPLE_RATE=0.5

# ── Stripe Connect marketplace payments — required for bookings ───────────
# Use test-mode keys locally. The webhook must subscribe to Checkout Session,
# PaymentIntent and connected-account updates at /api/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Expo build-time values (public by design) ─────────────────────────────────
# Configure distinct values in the EAS development, preview, and production
# environments once apps/mobile is created. Do not put secrets in this group.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_ORIGIN=http://localhost:3000
EXPO_PUBLIC_LINK_HOST=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

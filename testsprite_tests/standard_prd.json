  "product_overview": "REDRIVE is an Australian vehicle and adventure utility sharing platform, enabling seamless rentals and listings of a wide variety of vehicles from cars and motorhomes to boats and jetskis, designed with a modern, user-friendly, and secure interface for adventurers.",
  "core_goals": [
    "Provide a trusted and easy-to-use platform for renting and listing diverse utility vehicles and equipment.",
    "Ensure secure and verified user authentication and profile management including license verification.",
    "Facilitate smooth and reliable reservation workflows with dynamic pricing and insurance options.",
    "Enable real-time communication, notifications, and review systems to enhance user engagement and trust.",
    "Implement robust backend architecture with dual databases for reliability and data synchronization."
  ],
  "key_features": [
    "User Authentication & Registration with multi-provider support (email/password, Google OAuth).",
    "Comprehensive Vehicle Listings Management supporting multiple categories and rich media uploads.",
    "Advanced Reservation System with intelligent pricing, insurance plans, and status management.",
    "Reviews & Ratings system with post-trip validation and owner responses.",
    "Real-time Messaging and Chat system for user communication.",
    "Comprehensive Notifications System with multi-channel delivery and bulk management capabilities.",
    "Favorites System for users to save preferred listings.",
    "Integration with Google Places API for address autocomplete and validation.",
    "Image upload handling via Cloudinary integration.",
    "Dual database synchronization between MongoDB and Supabase for data reliability and analytics."
  ],
  "user_flow_summary": [
    "User registration and authentication via email/password or Google OAuth with license verification workflow.",
    "Vehicle listing creation including multi-image uploads, detailed specifications, and location input with Google Places autocomplete.",
    "Reservation process with date selection, insurance choice, dynamic pricing calculation, host approval, and trip confirmation.",
    "Post-trip review submission with star ratings and text feedback, including owner responses.",
    "Real-time chat initiation and message exchange between users.",
    "Notification receipt and management for bookings, reviews, messages, and system updates.",
    "Managing favorites by adding or removing vehicle listings.",
    "Image upload process to Cloudinary during listings or profile updates."
  ],
  "validation_criteria": [
    "Secure user authentication and data validation for registration and login workflows.",
    "Accurate vehicle listing creation with required fields and image handling.",
    "Reservation system correctly calculates pricing including service, platform, insurance, and optional cleaning fees.",
    "Reviews are only submitted post-trip with valid rating values.",
    "Real-time messaging is delivered and stored reliably with timestamps and read receipts.",
    "Notifications reach intended users and support read/unread states and bulk operations.",
    "Favorites system updates correctly for add and remove actions.",
    "Geolocation services provide accurate address suggestions and validation.",
    "Data synchronization between MongoDB and Supabase maintains consistency without conflicts."
  ],

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(auto()) @map("_id") @db.ObjectId
  name                       String?
  email                      String?   @unique
  emailVerified              DateTime?
  verificationCodeHash       String?
  verificationCodeExpires    DateTime?
  verificationCodeSentAt     DateTime?
  verificationAttempts       Int       @default(0)
  verificationRequired       Boolean?
  loginOtpEnabled            Boolean   @default(false)
  loginOtpCodeHash           String?
  loginOtpCodeExpires        DateTime?
  loginOtpCodeSentAt         DateTime?
  loginOtpAttempts           Int       @default(0)
  accountDeletionCodeHash    String?
  accountDeletionCodeExpires DateTime?
  accountDeletionCodeSentAt  DateTime?
  accountDeletionAttempts    Int       @default(0)
  number                     String?
  dateOfBirth                String?
  image                      String?
  hashedPassword             String?
  passwordChangedAt          DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastActiveAt               DateTime?
  favoriteIds                String[]  @db.ObjectId
  stripeConnectedAccountId   String?   @unique
  stripeDetailsSubmitted     Boolean   @default(false)
  stripePayoutsEnabled       Boolean   @default(false)
  stripeCustomerId           String? // for saved cards on the guest side (unique by construction)

  streetAddress     String?
  suburb            String?
  state             String?
  postcode          String?
  hobbies           String[] @default([])
  dreamDestinations String[] @default([])

  licenseImage                    String? // ✅ Stores uploaded license image
  licensePublicId                 String?
  licenseBackPublicId             String?
  licenseType                     String? // ✅ Stores selected license type
  licenseStatus                   String    @default("NOT_SUBMITTED")
  licenseExpiresAt                DateTime?
  licenseExpiryDate               String?
  licenseIssuerState              String?
  licenseHolderName               String?
  licenseDateOfBirth              String?
  licenseNumberEncrypted          String?
  licenseNumberLast4              String?
  licenseNumberHash               String?
  licenseCardEncrypted            String?
  licenseCardLast4                String?
  licenseNameMatches              Boolean?
  licenseDobMatches               Boolean?
  licenseClassificationConfidence Float?
  licenseVerificationSource       String?
  licenseOcrDataEncrypted         String?
  licenseVerifiedAt               DateTime?
  licenseReviewedAt               DateTime?
  licenseReviewedBy               String?   @db.ObjectId
  licenseRejectionReason          String?
  profileVerified                 String?   @default("N")
  role                            String?   @default("USER") // USER or ADMIN; nullable for existing MongoDB records

  // --- Communication preferences -----------------------------------------
  // Transactional messages about a live booking (request, payment, safety)
  // always send. These flags govern everything else.
  emailUnsubscribeToken    String?   @unique // one-click list-unsubscribe (Spam Act 2003)
  icalToken                String?   @unique // secret in the personal calendar-feed URL
  notifyEmailEnabled       Boolean   @default(true)
  notifyPushEnabled        Boolean   @default(true)
  notifySmsEnabled         Boolean   @default(false)
  marketingEmailConsent    Boolean   @default(false) // explicit opt-in for lifecycle / re-engagement mail
  marketingEmailConsentAt  DateTime?
  notificationPrefs        Json? // per-type channel overrides, e.g. { "REVIEW_REMINDER": { "email": false } }
  quietHoursStart          Int? // 0-23 local hour; push / SMS held during the window
  quietHoursEnd            Int?
  timezone                 String?   @default("Australia/Adelaide")
  licenseExpiryNoticeState String[]  @default([]) // reminder keys already sent, e.g. ["T-30", "T-7"]
  lifecycleEmailsSent      String[]  @default([]) // onboarding / re-engagement drip keys already sent
  lastReengagedAt          DateTime?
  lastHostStatementMonth   String? // "2026-08" — dedupes the monthly host statement
  guestRatingAvg           Float?
  guestRatingCount         Int       @default(0)
  tripsAsGuestCompleted    Int       @default(0)
  // Denormalised host response time (avg hours between a booking request and
  // the host's approve/decline, last 20). Kept fresh on each response so
  // listing search doesn't recompute it from reservations every query.
  responseTimeHours        Float?

  accounts            Account[]
  listings            Listing[]
  reservations        Reservation[]
  reviews             Review[]
  guestReviewsWritten GuestReview[]  @relation("GuestReviewAuthor")
  guestReviewsAbout   GuestReview[]  @relation("GuestReviewSubject")
  messagesSent        Message[]      @relation("UserMessages")
  notifications       Notification[]
  paymentsAsRenter    Payment[]      @relation("RenterPayments")
  paymentsAsOwner     Payment[]      @relation("OwnerPayments")

  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([role])
  @@index([licenseNumberHash])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Listing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  company     String
  modal       String
  imageSrcs   String[] @default([]) // ✅ Supports multiple images
  createdAt   DateTime @default(now())
  category    String
  guestCount  Int
  doorCount   Int
  sleepCount  Int
  fuelType    String
  fuelEconomy Float? // ✅ Allowing null values for fuel economy
  driveChain  String // ✅ Adding a new drive chain field
  year        Int
  information String?
  userId      String   @db.ObjectId
  price       Int
  amenities   String[] @default([])

  badge String? // ✅ New badge field

  // Denormalised review aggregates over the publicly-visible reviews
  // (published, or legacy reviews with no reservation). Recomputed whenever a
  // review for this listing is created or revealed — see libs/listingStats.ts.
  // Optional so listings that predate the backfill read as null, not an error.
  reviewAverage Float? @default(0)
  reviewCount   Int?   @default(0)

  state     String
  suburb    String
  address   String @default("")
  latitude  Float?
  longitude Float?

  regoNumber  String?   @unique
  regoEndDate DateTime?
  regoImage   String?

  cleaningFeeOption       String? // "YES", "NO", or "UPON_RETURNING"
  cleaningFeeAmount       Int?
  returnCleaningFeeAmount Int?

  instantBook              Boolean @default(false)
  minimumNoticeHours       Int     @default(24)
  minimumTripDays          Int     @default(1)
  maximumTripDays          Int     @default(30)
  preparationBufferHours   Int     @default(2)
  exactLocationReleaseRule String  @default("PAID_BOOKING") // "PAID_BOOKING" | "APPROVED_BOOKING"
  cancellationPolicy       String? @default("MODERATE")

  // --- Core specs ----------------------------------------------------------
  transmission        String? // "AUTOMATIC" | "MANUAL"
  odometer            Int? // km
  seatbeltCount       Int?
  colour              String?
  keysProvided        Int?
  fuelTankLitres      Int?
  drivingRangeKm      Int? // also used as EV range
  vehicleHeightMeters Float?
  vehicleLengthMeters Float?
  groundClearanceMm   Int?
  hasTollTag          Boolean @default(false)

  // --- Passengers & luggage ---------------------------------------------
  isofixPoints        Int?
  childSeatsAvailable Int?
  luggageLargeBags    Int?
  luggageCabinBags    Int?

  // --- EV / charging ---------------------------------------------------
  batteryCapacityKwh      Float?
  chargePortType          String? // "TYPE_2" | "CCS2" | "CHADEMO" | "TESLA_NACS"
  maxChargingKw           Float?
  portableChargerIncluded Boolean @default(false)

  // --- Condition & history -------------------------------------------
  damageNotes         String?
  damagePhotos        String[]  @default([])
  lastServicedAt      DateTime?
  lastServiceOdometer Int?
  tyreCondition       String? // "NEW" | "GOOD" | "FAIR"
  spareTyre           Boolean   @default(false)
  modifications       String?
  smokeFree           Boolean   @default(true)
  petFree             Boolean   @default(true)
  hasDashcam          Boolean   @default(false)
  hasGpsTracker       Boolean   @default(false)

  // --- Safety --------------------------------------------------------
  ancapRating      Int? // 1..5
  safetyFeatures   String[] @default([]) // ids from SAFETY_FEATURES_LIST
  firstAidKit      Boolean  @default(false)
  fireExtinguisher Boolean  @default(false)

  // --- Trip rules & limits ---------------------------------------
  dailyKmAllowance             Int? // null = unlimited
  excessKmFee                  Float? // AUD per km
  interstateAllowed            Boolean @default(true)
  interstateNotes              String?
  unsealedRoadsAllowed         Boolean @default(false)
  offRoadAllowed               Boolean @default(false)
  petsAllowed                  Boolean @default(false)
  smokingAllowed               Boolean @default(false)
  festivalsAllowed             Boolean @default(true)
  trackDaysAllowed             Boolean @default(false)
  additionalDriversAllowed     Boolean @default(true)
  additionalDriverFee          Int?
  minimumDriverAge             Int?
  minimumLicenceYears          Int?
  provisionalLicenceAllowed    Boolean @default(true)
  internationalLicenceAccepted Boolean @default(true)

  // --- Logistics & handover ------------------------------------
  deliveryAvailable  Boolean  @default(false)
  deliveryRadiusKm   Int?
  deliveryFee        Int?
  airportPickup      Boolean  @default(false)
  airportPickupFee   Int?
  handoverMethod     String? // "IN_PERSON" | "LOCKBOX" | "SELF_CHECKIN"
  pickupInstructions String?
  pickupWindowStart  String? // "08:00"
  pickupWindowEnd    String? // "20:00"
  timezone           String? // IANA zone for handover times, e.g. "Australia/Sydney" (derived from state when unset)
  languagesSpoken    String[] @default([])

  // --- Costs to expect (display only) ------------------------
  securityDeposit            Int?
  depositHoldMethod          String? // "PRE_AUTH" | "MANUAL_TRANSFER"
  weeklyDiscountPercent      Int?
  monthlyDiscountPercent     Int?
  lateReturnFeePerHour       Int?
  refuellingFeePerLitre      Float?
  tollHandling               String? // "TAG_INCLUDED" | "BILLED_BACK" | "GUEST_ARRANGES"
  finesAdminFee              Int?
  roadsideAssistanceIncluded Boolean @default(false)
  roadsideAssistanceProvider String?

  // --- Utes ---------------------------------------------------
  payloadKg                Int?
  gvmKg                    Int?
  towingCapacityBrakedKg   Int?
  towingCapacityUnbrakedKg Int?
  towBarFitted             Boolean @default(false)
  trayLengthMm             Int?
  trayWidthMm              Int?
  canopyFitted             Boolean @default(false)

  // --- Vans -------------------------------------------------
  loadVolumeCubicMetres Float?
  loadLengthMm          Int?
  internalHeightMm      Int?
  plyLined              Boolean @default(false)

  // --- Campervans / caravans / motorhomes ---------------
  sleepingConfiguration   String?
  bedDimensions           String?
  selfContained           Boolean @default(false)
  selfContainedCertNumber String?
  freshWaterLitres        Int?
  greyWaterLitres         Int?
  gasBottleKg             Float?
  solarWatts              Int?
  houseBatteryAmpHours    Int?
  awningFitted            Boolean @default(false)
  showerType              String? // "INTERNAL" | "EXTERNAL" | "NONE"
  toiletType              String? // "CASSETTE" | "COMPOSTING" | "PORTABLE" | "NONE"
  requiresSpecialLicence  Boolean @default(false)
  towVehicleRequirements  String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reviews      Review[]

  @@index([state, suburb, category, price])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([category, transmission])
}

model Reservation {
  id                         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                     String    @db.ObjectId
  listingId                  String    @db.ObjectId
  startDate                  DateTime
  endDate                    DateTime
  totalPrice                 Int
  redriveFee                 Int // ✅ Added redrive fee field
  serviceFee                 Int // ✅ New service fee field
  insuranceType              String // ✅ Stores "Risk Taker", "Happy Driver", or "No Insurance"
  insuranceFee               Int // ✅ Stores calculated insurance cost
  totalFees                  Int
  message                    String?   @db.String
  status                     String    @default("REVIEWING") // NEW: reviewing, APPROVED, DECLINED
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  respondedAt                DateTime?
  quoteSnapshot              Json?
  pricingPolicyVersion       String    @default("2026-08-17")
  paymentStatus              String    @default("NOT_STARTED")
  cancelledAt                DateTime?
  cancelledById              String?   @db.ObjectId
  cancellationReason         String?
  refundAmount               Int?
  refundPercentage           Int?
  cancellationPolicy         String?   @default("MODERATE")
  cancellationPolicySnapshot Json?
  pickupAddressReleasedAt    DateTime?
  paidAt                     DateTime?
  completedAt                DateTime?
  paymentDueAt               DateTime?
  confirmedAt                DateTime? // renter payment captured and held
  instantBooked              Boolean   @default(false)
  autoReleaseAt              DateTime? // return-handover deadlock auto-resolves at this time
  autoDeclineAt              DateTime? // an unanswered REVIEWING request lapses at this time
  returnHandoverAgreedAt     DateTime? // both parties agreed the return handover
  claimWindowEndsAt          DateTime? // payout holds until here so the host can inspect / claim
  remindersSent              String[]  @default([]) // lifecycle reminder keys already dispatched

  // Time-of-day for the physical handovers, "HH:MM" 24h, in the vehicle's
  // timezone (Listing.timezone). Pickup belongs to the host (they hand the
  // vehicle over) and is confirmed with the request; the return belongs to the
  // guest and is set once the trip is confirmed. The non-owning party can
  // *propose* a change — it stays unconfirmed until the owner confirms — and
  // the other side is notified at every step.
  pickupTime                 String? // when the guest collects on the pickup day
  pickupTimeSetByRole        String? // HOST | GUEST — who last set pickupTime
  pickupTimeProposedByRole   String? // set while a guest proposal awaits host confirmation
  pickupTimeConfirmed        Boolean   @default(true) // false → owner (host) must confirm
  pickupTimeUpdatedAt        DateTime?
  handoverTime               String? // when the guest returns the vehicle on the end day
  handoverTimeSetByRole      String? // HOST | GUEST — who last set handoverTime
  handoverTimeProposedByRole String? // set while a host proposal awaits guest confirmation
  handoverTimeConfirmed      Boolean   @default(false) // false → owner (guest) must confirm
  handoverTimeUpdatedAt      DateTime?

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payment     Payment?
  guestReview GuestReview?
  drivers     ReservationDriver[]
  extensions  TripExtension[]

  @@index([userId, status, createdAt])
  @@index([listingId, status, startDate, endDate])
  @@index([listingId, respondedAt])
  @@index([createdAt])
  @@index([status, paymentDueAt])
  @@index([status, autoDeclineAt])
  @@index([status, autoReleaseAt])
}

// A named driver on a booking. Primary = the guest by default; further drivers
// can be added at request time or after (SECONDARY, THIRD, ...). The check is
// lightweight: does the photo read as a current Australian licence?
model ReservationDriver {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  reservationId            String   @db.ObjectId
  role                     String // PRIMARY | SECONDARY | THIRD | FOURTH
  name                     String
  licenceImagePublicId     String
  licenceBackImagePublicId String?
  looksAustralian          Boolean  @default(false)
  detectedState            String? // "SA", "NSW", ...
  addedAfterBooking        Boolean  @default(false)
  createdAt                DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, role])
  @@index([reservationId])
}

// A guest's request to extend a paid trip by moving the end date out. The host
// approves (or Instant Book auto-approves if the dates are free), then the guest
// pays the pro-rata difference in its own checkout. On payment the reservation's
// dates and totals move and the extra owner amount is transferred at release.
model TripExtension {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  reservationId           String    @db.ObjectId
  requestedById           String    @db.ObjectId
  kind                    String    @default("EXTEND") // EXTEND | SHORTEN
  previousEndDate         DateTime
  newEndDate              DateTime
  extraDays               Int // EXTEND: days added. SHORTEN: negative days removed.
  extraBase               Int // EXTEND: owner top-up. SHORTEN: negative owner reduction.
  extraInsuranceFee       Int
  extraRedriveFee         Int
  extraServiceFee         Int
  extraTotal              Int // EXTEND: extra to pay. SHORTEN: negative refund total.
  refundAmount            Int? // SHORTEN: cents refunded to the guest on apply
  status                  String    @default("PENDING") // PENDING | APPROVED | DECLINED | PAID | APPLIED | EXPIRED
  stripeCheckoutSessionId String?
  stripeChargeId          String?
  stripeRefundId          String?
  paidAt                  DateTime?
  respondedAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
  @@index([status, expiresAt])
}

// Short-lived result of a driver-licence upload + analysis, held between the
// upload step and the booking submit so the client can't fake the outcome.
model LicenceCheck {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerUserId      String   @db.ObjectId
  frontPublicId    String   @unique
  backPublicId     String?
  looksAustralian  Boolean  @default(false)
  detectedState    String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([ownerUserId, createdAt])
  @@index([expiresAt])
}

model Payment {
  id                       String    @id @default(auto()) @map("_id") @db.ObjectId
  reservationId            String    @unique @db.ObjectId
  renterId                 String    @db.ObjectId
  ownerId                  String    @db.ObjectId
  amount                   Int
  ownerAmount              Int
  platformAmount           Int
  currency                 String    @default("aud")
  status                   String    @default("CHECKOUT_PENDING")
  stripeCheckoutSessionId  String?   @unique
  stripePaymentIntentId    String?   @unique
  stripeChargeId           String?
  stripeTransferId         String?   @unique
  stripeRefundId           String?
  cancellationPayoutAmount Int?
  cancellationPayoutDueAt  DateTime?
  // Refundable security deposit held via a separate manual-capture PaymentIntent.
  depositAmount            Int? // cents
  depositPaymentIntentId   String?
  depositStatus            String? // AUTHORIZED | RELEASED | CAPTURED | FAILED
  depositCapturedAmount    Int?
  failureMessage           String?
  paidAt                   DateTime?
  releasedAt               DateTime?
  refundedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  renter      User        @relation("RenterPayments", fields: [renterId], references: [id], onDelete: Restrict)
  owner       User        @relation("OwnerPayments", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([renterId, status, createdAt])
  @@index([ownerId, status, createdAt])
}

model StripeWebhookEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([processedAt])
}

model RateLimitBucket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// One row per cron job. Doubles as an overlap lock (a run won't start while a
// non-stale run holds the row) and a health record (last status + error).
model CronRun {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String    @unique
  startedAt  DateTime
  finishedAt DateTime?
  status     String // RUNNING | OK | ERROR
  error      String?
}

// Short-lived advisory lock serialising booking writes for one listing, so two
// concurrent requests for overlapping dates can't both pass the availability
// check and both insert. The unique listingId makes acquisition a single
// atomic insert; `expiresAt` lets a crashed holder's lock be reclaimed.
model BookingLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @unique @db.ObjectId
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Hourly, privacy-safe API telemetry. IDs are deterministic hashes of the
// environment/route/method/hour tuple, so atomic upserts do not depend on a
// separately-created MongoDB unique index.
model ApiMetricBucket {
  id                String   @id @map("_id") @db.ObjectId
  key               String
  environment       String
  route             String
  method            String
  region            String?
  windowStart       DateTime
  expiresAt         DateTime
  requestCount      Int      @default(0)
  sampleCount       Int      @default(0)
  successCount      Int      @default(0)
  redirectCount     Int      @default(0)
  clientErrorCount  Int      @default(0)
  serverErrorCount  Int      @default(0)
  rateLimitedCount  Int      @default(0)
  unauthorisedCount Int      @default(0)
  totalDurationMs   Float    @default(0)
  totalCpuMs        Float    @default(0)
  totalMemoryMb     Float    @default(0)
  totalRequestBytes Float    @default(0)
  durationLt100     Int      @default(0)
  durationLt500     Int      @default(0)
  durationLt1000    Int      @default(0)
  durationLt3000    Int      @default(0)
  durationGte3000   Int      @default(0)
  coldStartCount    Int      @default(0)
  lastStatus        Int?
  lastSeenAt        DateTime @updatedAt

  @@index([environment, windowStart])
  @@index([route, method, windowStart])
  @@index([expiresAt])
}

// Only unexpected server failures are retained as individual events. Request
// bodies, query strings, user IDs and raw IP addresses are never stored.
model ApiErrorEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  environment String
  route       String
  method      String
  region      String?
  status      Int
  durationMs  Float
  errorName   String?
  requestId   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([environment, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId String?  @db.ObjectId
  action      String
  targetType  String
  targetId    String?
  reason      String?
  metadata    Json?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model AvailabilityBlock {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId  String   @db.ObjectId
  startDate  DateTime
  endDate    DateTime
  type       String   @default("OWNER_BLOCK") // OWNER_BLOCK | EXTERNAL_ICAL
  reason     String?
  externalUid String? // VEVENT UID, so an external sync can update/remove its own blocks
  createdAt  DateTime @default(now())

  @@index([listingId, startDate, endDate])
  @@index([listingId, type])
}

// One or more external iCal feeds (Airbnb, Camplify, Google, …) a host wants
// mirrored into a listing's blocked dates.
model ExternalCalendar {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  listingId    String    @db.ObjectId
  url          String
  label        String?
  lastSyncedAt DateTime?
  lastStatus   String? // OK | ERROR
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([listingId])
}

model BookingQuote {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  listingId     String   @db.ObjectId
  reservationId String?  @db.ObjectId
  startDate     DateTime
  endDate       DateTime
  days          Int
  dailyRate     Int
  basePrice     Int
  redriveFee    Int
  serviceFee    Int
  insuranceType String
  insuranceFee  Int
  cleaningFee   Int
  total         Int
  currency      String   @default("AUD")
  policyVersion String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([listingId, startDate, endDate])
  @@index([expiresAt])
}

model UserSession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  tokenHash  String    @unique
  deviceName String?
  browser    String?
  ipHash     String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt, lastSeenAt])
  @@index([expiresAt])
}

// Native app sessions use rotating opaque refresh tokens and independently
// signed, short-lived access tokens. A row is retained after rotation so reuse
// of an old refresh token can revoke the complete token family.
model MobileSession {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  tokenFamilyId    String
  refreshTokenHash String    @unique
  deviceId         String
  deviceName       String?
  platform         String
  appVersion       String?
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt, lastSeenAt])
  @@index([tokenFamilyId, revokedAt])
  @@index([expiresAt])
}

model MobileAuthChallenge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  purpose    String
  deviceId   String
  deviceName String?
  platform   String
  appVersion String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model MobilePushToken {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  token          String    @unique
  deviceId       String
  platform       String
  appEnvironment String
  lastSeenAt     DateTime  @default(now())
  disabledAt     DateTime?
  invalidAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, deviceId, appEnvironment])
  @@index([userId, disabledAt, lastSeenAt])
}

model IdempotencyRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fingerprint String   @unique
  actorUserId String   @db.ObjectId
  scope       String
  keyHash     String
  requestHash String
  status      Int      @default(0)
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([actorUserId, scope, createdAt])
  @@index([expiresAt])
}

model WebAuthnCredential {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId, createdAt])
}

model HandoverReport {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  reservationId     String    @db.ObjectId
  phase             String
  submittedById     String    @db.ObjectId
  odometer          Int?
  fuelOrChargeLevel Int?
  checklist         Json?
  notes             String?
  acknowledgedByIds String[]  @db.ObjectId
  status            String    @default("DRAFT")
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([reservationId, phase])
  @@index([submittedById, createdAt])
}

model HandoverMedia {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  reportId  String   @db.ObjectId
  url       String
  publicId  String?
  category  String
  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
}

model IncidentCase {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  reservationId     String    @db.ObjectId
  reporterUserId    String    @db.ObjectId
  type              String
  status            String    @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | ESCALATED
  summary           String
  location          String?
  evidence          Json?
  // The other party's side of the story.
  responderUserId   String?   @db.ObjectId
  responderStatement String?
  respondedAt       DateTime?
  // How it was closed out.
  resolution        String?
  resolutionOutcome String? // NO_ACTION | DEPOSIT_DEDUCTION | PARTIAL_REFUND | GOODWILL | ESCALATED
  resolutionAmount  Int? // AUD, informational — actual money movement is done by ops
  resolvedByUserId  String?   @db.ObjectId
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([reservationId, createdAt])
  @@index([reporterUserId, status, createdAt])
  @@index([status, createdAt])
}

model SavedSearch {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  name           String
  filters        Json
  alertFrequency String    @default("DAILY")
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, active, createdAt])
}

model MaintenanceRecord {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  listingId   String    @db.ObjectId
  type        String
  status      String    @default("DUE")
  dueAt       DateTime?
  completedAt DateTime?
  odometer    Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([listingId, status, dueAt])
}

model FeatureFlag {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0)
  allowedUserIds    String[] @db.ObjectId
  updatedAt         DateTime @updatedAt
}

model Review {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId // author (the guest)
  listingId     String    @db.ObjectId
  reservationId String?   @db.ObjectId // ties the review to a specific completed trip
  rating        Int
  text          String    @db.String
  response      String?   @db.String // host's public reply
  respondedAt   DateTime?
  publishedAt   DateTime? // blind reveal — null until the guest-review counterpart lands or 14 days pass
  createdAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId, publishedAt])
  @@index([reservationId])
}

// A saved vehicle. Written alongside the legacy `User.favoriteIds` array while
// reads migrate over: this row carries a `createdAt` (so "recently saved" is a
// real query, not an array reversal) and is indexed by listing (so a host can
// see who saved a vehicle without scanning every user).
model Favourite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  listingId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId, createdAt])
}

// Host's review of a guest. Kept separate from Review so existing guest→host
// data and queries are untouched. Both sides reveal together (see the
// review-reveal cron).
model GuestReview {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String    @unique @db.ObjectId
  authorId      String    @db.ObjectId // host
  subjectUserId String    @db.ObjectId // guest being reviewed
  listingId     String    @db.ObjectId
  rating        Int
  text          String    @db.String
  response      String?   @db.String // the guest's public reply
  respondedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  author      User        @relation("GuestReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject     User        @relation("GuestReviewSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([subjectUserId, publishedAt])
  @@index([authorId, createdAt])
}

model Badge {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

model Chat {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  participantIds String[]  @db.ObjectId
  messages       Message[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Ephemeral typing-indicator state (1:1 chats, single active typer)
  typingUserId String?   @db.ObjectId
  typingAt     DateTime?

  @@index([participantIds])
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  chatId    String   @db.ObjectId
  senderId  String   @db.ObjectId
  text      String?
  imageUrl  String?
  system    Boolean  @default(false) // app-authored line (e.g. a handover-time change), rendered as a centred note
  readByIds String[] @default([]) @db.ObjectId
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional data like listingId, reservationId, etc.
  read      Boolean          @default(false)
  actionUrl String? // Where to redirect when clicked
  createdAt DateTime         @default(now())
  expiresAt DateTime? // Optional expiration for time-sensitive notifications

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// One row per (event, channel) actually dispatched. Gives every lifecycle
// message an idempotency key so retried crons and duplicate webhooks never
// double-send, and a delivery log for support.
model NotificationDelivery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  dedupeKey String   @unique // e.g. "reservation:<id>:payment_confirmed:EMAIL"
  channel   String // IN_APP | EMAIL | PUSH | SMS
  type      String // NotificationType value or a lifecycle key
  status    String   @default("SENT") // SENT | FAILED | SKIPPED
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum NotificationType {
  BOOKING_REQUEST // New booking request received
  BOOKING_APPROVED // Your booking was approved
  BOOKING_DECLINED // Your booking was declined
  BOOKING_CANCELLED // Booking was cancelled
  BOOKING_REMINDER // Upcoming booking reminder
  BOOKING_COMPLETED // Booking completed
  BOOKING_CONFIRMED // Payment captured — trip is locked in
  BOOKING_REQUEST_EXPIRED // An unanswered request lapsed

  REVIEW_RECEIVED // New review on your listing
  REVIEW_REMINDER // Reminder to leave a review
  REVIEW_PUBLISHED // A review you're part of is now visible

  MESSAGE_RECEIVED // New message in chat

  LISTING_FAVORITED // Someone favorited your listing
  LISTING_UPDATED // Your listing was updated

  PROFILE_VERIFIED // Profile verification status change
  PAYMENT_RECEIVED // Payment received
  PAYMENT_REQUIRED // Payment required
  PAYMENT_WINDOW_CLOSING // Payment window is about to expire
  PAYMENT_FAILED // A payment attempt failed
  PAYOUT_RELEASED // Funds released to the host
  PAYOUT_SETUP_REQUIRED // Host must finish Stripe onboarding

  TRIP_STARTING // Pickup is coming up
  TRIP_RETURNING // Return / drop-off is coming up
  HANDOVER_ACTION // A handover step needs you
  LICENCE_EXPIRING // Driver licence is about to expire
  HOST_STATEMENT // Monthly host earnings statement

  SYSTEM_UPDATE // System notifications
  SECURITY_ALERT // Security-related notifications
}

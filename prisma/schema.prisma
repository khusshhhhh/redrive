generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  number         String?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  favoriteIds    String[]  @db.ObjectId

  streetAddress  String?
  suburb         String?
  state          String?
  postcode       String?
  hobbies        String[]  @default([])  
  dreamDestinations String[] @default([]) 

  licenseImage   String?  // ✅ Stores uploaded license image
  licenseType    String?  // ✅ Stores selected license type
  profileVerified   String?   @default("N")

  accounts     Account[]
  listings     Listing[]
  reservations Reservation[]
  reviews      Review[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Listing {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  company       String
  modal         String
  imageSrcs     String[] @default([]) // ✅ Supports multiple images
  createdAt     DateTime @default(now())
  category      String
  guestCount    Int
  doorCount     Int
  sleepCount    Int
  fuelType      String
  fuelEconomy   Float?    // ✅ Allowing null values for fuel economy
  driveChain    String    // ✅ Adding a new drive chain field
  year          Int
  information   String?
  userId        String   @db.ObjectId
  price         Int
  amenities     String[] @default([])

  badge         String?  // ✅ New badge field

  state        String
  suburb       String
  address      String    @default("")
  latitude     Float?
  longitude    Float?

  // ✅ New fields for registration details
  regoNumber   String?  @unique // Ensure unique registration numbers
  regoEndDate  DateTime? 
  regoImage    String?  // Store Cloudinary image URL

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reviews      Review[]
}

model Reservation {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  listingId  String   @db.ObjectId
  startDate  DateTime
  endDate    DateTime
  totalPrice Int
  redriveFee Int  // ✅ Added redrive fee field
  serviceFee Int  // ✅ New service fee field
  insuranceType String   // ✅ Stores "Risk Taker", "Happy Driver", or "No Insurance"
  insuranceFee  Int      // ✅ Stores calculated insurance cost
  totalFees  Int
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  listingId String   @db.ObjectId
  rating    Int
  text      String   @db.String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Badge {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

{
  "name": "redrive",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "tsx --test app/libs/*.test.ts",
    "typecheck:contracts": "npm run typecheck --workspace @redrive/contracts",
    "typecheck:mobile": "npm run typecheck --workspace @redrive/mobile",
    "doctor:mobile": "npm exec --workspace @redrive/mobile -- expo-doctor",
    "test:mobile": "tsx --test apps/mobile/src/**/*.test.ts",
    "verify:mobile-release": "node scripts/verify-mobile-release.mjs",
    "quality:mobile": "prisma generate && npm run typecheck:contracts && npm run typecheck:mobile && npm run lint --workspace @redrive/mobile && npm run test:mobile && npm test && npm run doctor:mobile && npm run verify:mobile-release",
    "lint": "next lint",
    "analyze": "cross-env ANALYZE=true next build",
    "bundle-analyzer": "npx @next/bundle-analyzer",
    "analyze-performance": "node scripts/analyze-bundle.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@googlemaps/markerclusterer": "^2.5.3",
    "@mui/material": "^6.4.6",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@phosphor-icons/react": "^2.1.7",
    "@prisma/client": "^6.12.0",
    "@redrive/contracts": "*",
    "@tabler/icons-react": "^3.30.0",
    "@types/google.maps": "^3.58.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.477.0",
    "mongodb": "^6.21.0",
    "next-auth": "^4.24.15",
    "nodemailer-v9": "npm:nodemailer@^9.0.5",
    "query-string": "^9.1.1",
    "react": "19.2.3",
    "react-date-range": "^2.0.1",
    "react-dom": "19.2.3",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^5.4.0",
    "react-image-gallery": "^1.4.0",
    "react-leaflet": "^5.0.0",
    "react-select": "^5.10.0",
    "react-spinners": "^0.15.0",
    "redis": "^6.2.1",
    "sharp": "^0.35.0",
    "stripe": "^22.5.0",
    "world-countries": "^5.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.23",
    "@types/bcrypt": "^5.0.2",
    "@types/leaflet": "^1.9.16",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-date-range": "^1.4.9",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "next": "^15.5.23",
    "postcss": "8.5.26",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.0",
    "@img/sharp-linux-x64": "0.35.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "next": {
      "sharp": "0.35.0"
    }
  }
}

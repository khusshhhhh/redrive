{
  "name": "redrive",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:ttl-indexes": "node scripts/create-ttl-indexes.mjs",
    "db:backfill-favourites": "node scripts/backfill-favourites.mjs",
    "db:backfill-listing-stats": "node scripts/backfill-listing-stats.mjs",
    "test": "tsx --test app/libs/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:contracts": "npm run typecheck --workspace @redrive/contracts",
    "typecheck:mobile": "npm run typecheck --workspace @redrive/mobile",
    "doctor:mobile": "npm exec --workspace @redrive/mobile -- expo-doctor",
    "test:mobile": "tsx --test apps/mobile/src/**/*.test.ts",
    "test:e2e": "playwright test",
    "verify:mobile-release": "node scripts/verify-mobile-release.mjs",
    "quality:mobile": "prisma generate && npm run typecheck:contracts && npm run typecheck:mobile && npm run lint --workspace @redrive/mobile && npm run test:mobile && npm test && npm run doctor:mobile && npm run verify:mobile-release",
    "lint": "next lint",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "analyze": "cross-env ANALYZE=true next build",
    "bundle-analyzer": "npx @next/bundle-analyzer",
    "analyze-performance": "node scripts/analyze-bundle.js"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.12.0",
    "@redrive/contracts": "*",
    "@sentry/nextjs": "^10.73.0",
    "@tabler/icons-react": "^3.30.0",
    "@types/google.maps": "^3.58.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "date-fns": "^4.1.0",
    "flicker-dot": "^0.1.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.477.0",
    "mongodb": "^6.21.0",
    "next-auth": "^4.24.15",
    "nodemailer-v9": "npm:nodemailer@^9.0.5",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "query-string": "^9.1.1",
    "react": "19.2.3",
    "react-date-range": "^2.0.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-image-gallery": "^1.4.0",
    "react-loading-skeleton": "^3.5.0",
    "react-select": "^5.10.0",
    "react-spinners": "^0.15.0",
    "sharp": "^0.35.0",
    "stripe": "^22.5.0",
    "swr": "^2.5.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.23",
    "@playwright/test": "^1.49.1",
    "@types/bcrypt": "^5.0.2",
    "@types/leaflet": "^1.9.16",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-date-range": "^1.4.9",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "next": "^15.5.23",
    "postcss": "8.5.26",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.0",
    "@img/sharp-linux-x64": "0.35.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "next": {
      "sharp": "0.35.0"
    },
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
